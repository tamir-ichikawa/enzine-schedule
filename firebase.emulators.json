{
  "firestore": {
    "rules": "firestore.emulator.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase.emulators.json",
      ".firebaserc",
      ".agents/**",
      ".codex/**",
      ".firebase/**",
      ".git/**",
      ".github/**",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "scripts/**",
      "tests/**",
      "package*.json",
      "LOCAL_FIREBASE_EMULATORS.md",
      "MULTI_OFFICE_FOUNDATION.md",
      "firestore.emulator.rules"
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ],
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "hosting": {
      "host": "127.0.0.1",
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 4000
    },
    "singleProjectMode": true
  }
}
